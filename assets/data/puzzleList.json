---
---
[
  {% assign sorted_puzzles = site.puzzles | sort: "order" %}
  {% for puzzle in sorted_puzzles %}
  [
    "{{ puzzle.slug }}",
    "{{ puzzle.title}}",
    "{{ puzzle.creation_date }}",
    "{{ puzzle.creation_date | date: "%-d %B %Y" }}",
    {{ puzzle.order | default: 0 }},
    "{% include puzzle-image.html puzzle=puzzle %}"
  ]{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
